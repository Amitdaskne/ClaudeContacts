<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    
    <androidx.appcompat.widget.Toolbar android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="@color/claude_bg" android:elevation="0dp" app:title="Contacts" app:titleTextColor="@color/claude_text"/>
        
    <com.google.android.material.tabs.TabLayout android:id="@+id/tabLayout"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/claude_bg" app:tabIndicatorColor="@color/claude_accent"
        app:tabTextColor="@color/claude_subtext" app:tabSelectedTextColor="@color/claude_accent"/>
        
    <androidx.viewpager2.widget.ViewPager2 android:id="@+id/viewPager"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>

    <Button android:id="@+id/btnSync" android:layout_width="match_parent" android:layout_height="56dp"
        android:layout_margin="16dp" android:text="Sync Device to Cloud" android:textAllCaps="false"
        android:background="@drawable/bg_claude_button" android:textColor="#FFF"/>
</LinearLayout>
