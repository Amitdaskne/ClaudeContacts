<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">
    
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/tvName" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Name" android:textSize="16sp" android:textColor="@color/claude_text" android:textStyle="bold"/>
        <TextView android:id="@+id/tvNumber" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Number" android:textSize="14sp" android:textColor="@color/claude_subtext" android:layout_marginTop="4dp"/>
    </LinearLayout>

    <!-- Cloud Tab me hi delete dikhega -->
    <ImageView android:id="@+id/btnDelete" android:layout_width="24dp" android:layout_height="24dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel" android:tint="@color/claude_subtext"
        android:visibility="gone" android:padding="2dp" android:background="?attr/selectableItemBackgroundBorderless"/>
</LinearLayout>
